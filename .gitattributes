# Normalize text to LF in the repo; checkout as LF on all platforms.
# Avoids Windows core.autocrlf noise on generated bindings / go.mod.

* text=auto eol=lf

# Source
*.go     text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.vue    text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.sql    text eol=lf
*.xml    text eol=lf
*.opml   text eol=lf
*.svg    text eol=lf
*.rhai   text eol=lf

# Shell / env
*.sh     text eol=lf
*.ps1    text eol=lf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.pdf    binary
*.zip    binary
*.7z     binary
*.exe    binary
*.dll    binary
*.so     binary
*.dylib  binary
*.db     binary
*.sqlite binary
